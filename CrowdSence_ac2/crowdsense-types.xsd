    <!-- Email válido -->

    <!-- Latitud geográfica (-90 a 90 grados) -->
    <xs:simpleType name="LatitudType">
        <xs:annotation>
            <xs:documentation>
                Latitud geográfica en grados decimales.
                Rango válido: -90 (Polo Sur) a 90 (Polo Norte).
                Ejemplo: 40.416775 (Madrid)
            </xs:documentation>
        </xs:annotation>
        <!-- TODO -->
    </xs:simpleType>

    <!-- Longitud geográfica (-180 a 180 grados) -->
    <xs:simpleType name="LongitudType">
        <xs:annotation>
            <xs:documentation>
                Longitud geográfica en grados decimales.
                Rango válido: -180 (Oeste) a 180 (Este).
                Ejemplo: -3.703790 (Madrid)
            </xs:documentation>
        </xs:annotation>
        <!-- TODO -->
    </xs:simpleType>

    <!-- Superficie en metros cuadrados (debe ser positiva) -->
    <xs:simpleType name="SuperficieType">
        <xs:annotation>
            <xs:documentation>
                Superficie de un espacio en metros cuadrados.
                Debe ser un valor positivo mayor que cero.
            </xs:documentation>
        </xs:annotation>
        <!-- TODO -->
    </xs:simpleType>

    <!-- Modo de captura de la sonda -->
    <xs:simpleType name="ModoCapturaType">
        <xs:annotation>
            <xs:documentation>
                Modo de operación de captura de la sonda.
                CONTINUO: Captura permanente mientras esté activa.
                PROGRAMADO: Captura en horarios predefinidos.
                BAJO_DEMANDA: Captura solo cuando se solicita.
            </xs:documentation>
        </xs:annotation>
        <!-- TODO -->
    </xs:simpleType>

    <!-- Intervalo de captura en milisegundos (con límites razonables) -->
    <xs:simpleType name="IntervaloCapturaType">
        <xs:annotation>
            <xs:documentation>
                Intervalo de captura en milisegundos.
                Mínimo: 10ms (evita saturación del sistema).
                Máximo: 60000ms (1 minuto, evita pérdida excesiva de datos).
            </xs:documentation>
        </xs:annotation>
        <!-- TODO -->
    </xs:simpleType>

</xs:schema>
