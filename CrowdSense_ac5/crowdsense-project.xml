<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dataset de entrada para la Actividad 5 (XPath).

  Estructura:
    crowdSenseProject (raíz, atributos: version, generadoEn)
      metadata          → nombre, responsable, fechaCreacion
      estadisticas      → totalCampanas, totalProbes
      sondas            → varias <sonda status="ACTIVE|INACTIVE">
                            nombre, ubicacionRef
                            probes → varios <probe secuencia="N">
                                       macAddress, ssid, rssi,
                                       timestamp, location/edificio, location/planta

  Namespace por defecto: http://upm.es/piat/crowdsense
  En las consultas XPath se debe usar el prefijo "cs:" (registrado por
  XPathQueryEngine), porque el JDK XPath no resuelve namespaces sin prefijo.
  
  DOM:
 *     <?xml version="1.0"?>
		crowdSenseProject @version @generadoEn
		L metadata
		|	L nombreProyecto
		|	L responsable
		|	L fechaCreacion
		|
		L estadisticas
		|	L totalCampanas
		|	L totalProbes
		|
		L sondas
			L sonda @id @status
				L nombre
				L ubicacionRef
				L probes
					L probe @secuencia
						L mac
						L ssid
						L rssi
						L timestamp
						L location 
							L edificio
							L planta
  
-->
